# Copia este archivo a .env y ajusta lo que necesites:  cp .env.example .env
# Todas las variables son opcionales; estos son los valores por defecto.

# Credenciales comunes a todas las bases de datos
DB_USER=dev
DB_PASSWORD=devpass
DB_NAME=devdb

# Interfaz donde se publican los puertos.
# 127.0.0.1 = solo tu máquina (recomendado). 0.0.0.0 = también tu red local.
BIND_ADDRESS=127.0.0.1

# Puertos en tu máquina (cámbialos si ya están ocupados)
POSTGRES_PORT=5432
MYSQL_PORT=3306
MONGO_PORT=27017
REDIS_PORT=6379
ADMINER_PORT=8080
MONGO_EXPRESS_PORT=8081
REDIS_COMMANDER_PORT=8082

# Versiones de las imágenes (tags de Docker Hub)
POSTGRES_VERSION=15-alpine
MYSQL_VERSION=8.0-oracle
MONGO_VERSION=7.0-jammy
REDIS_VERSION=7-alpine
ADMINER_VERSION=5.4.1
MONGO_EXPRESS_VERSION=1.0.2
REDIS_COMMANDER_VERSION=latest
